# =============================================================================
# AdForge AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:  cp .env.example .env

# -- Application --
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# -- Database --
DATABASE_URL=postgresql+asyncpg://adforge:adforge@postgres:5432/adforge
DATABASE_URL_SYNC=postgresql://adforge:adforge@postgres:5432/adforge
POSTGRES_USER=adforge
POSTGRES_PASSWORD=adforge
POSTGRES_DB=adforge

# -- Redis --
REDIS_URL=redis://redis:6379/0

# -- LLM APIs (leave blank to use mock/stub agents) --
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -- Meta Marketing API (leave blank to use mock) --
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# -- Frontend --
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# -- Celery --
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
